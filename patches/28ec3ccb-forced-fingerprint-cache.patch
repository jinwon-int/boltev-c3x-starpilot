diff --git a/selfdrive/car/tests/test_card_cache.py b/selfdrive/car/tests/test_card_cache.py
new file mode 100644
index 00000000..46dc7b62
--- /dev/null
+++ b/selfdrive/car/tests/test_card_cache.py
@@ -0,0 +1,124 @@
+from unittest.mock import patch
+
+from cereal import car
+
+from openpilot.selfdrive.car.car_params_cache import get_cached_params_raw
+
+
+BOLT_2017 = "CHEVROLET_BOLT_CC_2017"
+VALID_VIN = "1G1F76E02H4165708"
+
+
+class FakeLogger:
+  def warning(self, *args, **kwargs):
+    pass
+
+  def exception(self, *args, **kwargs):
+    pass
+
+
+LOGGER = FakeLogger()
+
+
+class FakeParams:
+  def __init__(self, values=None):
+    self.values = values or {}
+
+  def get(self, key, encoding=None):
+    value = self.values.get(key)
+    if value is not None and encoding is not None and isinstance(value, bytes):
+      return value.decode(encoding)
+    return value
+
+  def get_bool(self, key):
+    return bool(self.values.get(key, False))
+
+
+def build_car_params(*, fingerprint=BOLT_2017, brand="gm", vin=VALID_VIN, with_fw=True):
+  cp = car.CarParams.new_message()
+  cp.carFingerprint = fingerprint
+  cp.brand = brand
+  cp.carVin = vin
+  if with_fw:
+    fw = cp.init("carFw", 1)
+    fw[0].ecu = "eps"
+    fw[0].address = 0x730
+    fw[0].brand = brand
+    fw[0].fwVersion = b"verified"
+  return cp.to_bytes()
+
+
+def test_volatile_cache_always_wins():
+  volatile = b"volatile-cache"
+  params = FakeParams({
+    "CarParamsCache": volatile,
+    "CarParamsPersistent": b"not-capnp",
+    "ForceFingerprint": True,
+    "CarModel": "OTHER_CAR",
+  })
+  assert get_cached_params_raw(params, LOGGER) == volatile
+
+
+def test_persistent_cache_requires_forced_fingerprint():
+  persistent = build_car_params()
+  params = FakeParams({"CarParamsPersistent": persistent, "CarModel": BOLT_2017})
+  assert get_cached_params_raw(params, LOGGER) is None
+
+
+def test_matching_forced_fingerprint_reuses_persistent_cache():
+  persistent = build_car_params()
+  params = FakeParams({
+    "CarParamsPersistent": persistent,
+    "ForceFingerprint": True,
+    "CarModel": BOLT_2017.encode(),
+  })
+  assert get_cached_params_raw(params, LOGGER) == persistent
+
+
+def test_persistent_cache_avoids_live_diagnostic_queries():
+  from opendbc.car.car_helpers import fingerprint
+
+  persistent = build_car_params()
+  sent = []
+  obd_modes = []
+  with car.CarParams.from_bytes(persistent) as cached_params:
+    with patch("opendbc.car.car_helpers.Params", return_value=FakeParams()), \
+         patch("opendbc.car.car_helpers.match_fw_to_car", return_value=(True, {BOLT_2017})), \
+         patch("opendbc.car.car_helpers.can_fingerprint", return_value=(BOLT_2017, {0: {}, 1: {}, 2: {}})):
+      result = fingerprint(
+        lambda wait_for_one=False: [],
+        lambda msgs: sent.extend(msgs),
+        lambda enabled: obd_modes.append(enabled),
+        num_pandas=1,
+        cached_params=cached_params,
+      )
+
+  assert result[0] == BOLT_2017
+  assert sent == []
+  assert obd_modes == [False]
+
+
+def test_mismatched_forced_fingerprint_fails_closed():
+  persistent = build_car_params(fingerprint="OTHER_CAR")
+  params = FakeParams({
+    "CarParamsPersistent": persistent,
+    "ForceFingerprint": True,
+    "CarModel": BOLT_2017,
+  })
+  assert get_cached_params_raw(params, LOGGER) is None
+
+
+def test_incomplete_persistent_cache_fails_closed():
+  cases = [
+    build_car_params(brand="mock"),
+    build_car_params(vin="0" * 17),
+    build_car_params(with_fw=False),
+    b"not-capnp",
+  ]
+  for persistent in cases:
+    params = FakeParams({
+      "CarParamsPersistent": persistent,
+      "ForceFingerprint": True,
+      "CarModel": BOLT_2017,
+    })
+    assert get_cached_params_raw(params, LOGGER) is None
