diff --git a/selfdrive/car/car_params_cache.py b/selfdrive/car/car_params_cache.py
new file mode 100644
index 00000000..a4d6a65f
--- /dev/null
+++ b/selfdrive/car/car_params_cache.py
@@ -0,0 +1,38 @@
+import re
+
+from cereal import car
+
+
+VIN_RE = re.compile(r"[A-HJ-NPR-Z0-9]{17}")
+VIN_UNKNOWN = "0" * 17
+
+
+def get_cached_params_raw(params, logger) -> bytes | None:
+  cached_params_raw = params.get("CarParamsCache")
+  if cached_params_raw is not None or not params.get_bool("ForceFingerprint"):
+    return cached_params_raw
+
+  persistent_params_raw = params.get("CarParamsPersistent")
+  forced_model = params.get("CarModel", encoding="utf-8")
+  if persistent_params_raw is None or not forced_model:
+    return None
+
+  try:
+    with car.CarParams.from_bytes(persistent_params_raw) as persistent_params:
+      cache_matches_forced_model = (
+        persistent_params.carFingerprint == forced_model and
+        persistent_params.brand != "mock" and
+        len(persistent_params.carFw) > 0 and
+        persistent_params.carVin != VIN_UNKNOWN and
+        VIN_RE.fullmatch(persistent_params.carVin) is not None
+      )
+  except Exception:
+    logger.exception("Failed to parse persistent CarParams for forced fingerprint cache")
+    return None
+
+  if not cache_matches_forced_model:
+    logger.warning("Ignoring persistent CarParams that do not match the forced fingerprint")
+    return None
+
+  logger.warning("Using persistent CarParams for forced fingerprint")
+  return persistent_params_raw
